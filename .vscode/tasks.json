{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Dependencies",
            "type": "shell",
            "command": "${workspaceFolder}/backend/venv/Scripts/pip.exe",
            "args": ["install", "-r", "requirements.txt"],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Backend (FastAPI)",
            "type": "shell",
            "command": "${workspaceFolder}/backend/venv/Scripts/python.exe",
            "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Uvicorn running on.*",
                    "endsPattern": ".*Application startup complete.*"
                }
            },
            "presentation": {
                "group": "servers",
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Start Frontend (HTTP Server)",
            "type": "shell",
            "command": "${workspaceFolder}/backend/venv/Scripts/python.exe",
            "args": ["-m", "http.server", "5500"],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Serving HTTP on.*",
                    "endsPattern": ".*Serving HTTP on.*"
                }
            },
            "presentation": {
                "group": "servers",
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Start Full Project",
            "dependsOn": [
                "Start Backend (FastAPI)",
                "Start Frontend (HTTP Server)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
