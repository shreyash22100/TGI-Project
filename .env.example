# Copy this file to .env and edit as needed. Never commit a real .env file.

# Which Hugging Face model to load in CPU/demo mode
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# cpu or cuda (only relevant if you have a GPU available to the backend)
DEVICE=cpu

# Generation limits
DEFAULT_MAX_NEW_TOKENS=40
MAX_ALLOWED_NEW_TOKENS=200

# Simulated scheduler batch-collection window (seconds) for the batching demo
BATCH_WINDOW_SECONDS=0.15

# Comma-separated list, or * for any origin (fine for a local demo)
ALLOWED_ORIGINS=*

HOST=0.0.0.0
PORT=8000

# Only needed if you use a gated model from the Hugging Face Hub
# HUGGINGFACE_TOKEN=
